---
import '../../styles/global.css';
import Navigation from '../../components/Navigation.astro';
import MelodicSensitivity from '../../components/MelodicSensitivity';
import CookieFortune from '../../components/CookieFortune.astro';
---

<!DOCTYPE html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="dark" />
    <meta name="robots" content="index, follow" />
    <title>Melodic Codec Sensitivity Tester | 776F6C6E6F</title>
    <meta name="description" content="Music as an AI instruction surface. Understand how melodic codec embeds machine-readable payloads in audio, how to defend against unwanted decoding, and how to use it positively. Educational research tool." />
    <meta property="og:title" content="Melodic Codec Sensitivity Tester" />
    <meta property="og:description" content="Music encodes instructions for AI. Explore the melodic codec vector, defensive practices, and consentful use. Educational security research." />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://776f6c6e6f.org/narzedzia/melodic-sensitivity/" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content="https://776f6c6e6f.org/og/og-default.png" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content="https://776f6c6e6f.org/og/og-default.png" />
    <link rel="canonical" href="https://776f6c6e6f.org/narzedzia/melodic-sensitivity/" />
    <link rel="alternate" hreflang="en" href="https://776f6c6e6f.org/narzedzia/melodic-sensitivity/" />
    <link rel="alternate" hreflang="pl" href="https://776f6c6e6f.org/pl/narzedzia/melodic-sensitivity/" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;700&display=swap" rel="stylesheet" />
    <script type="application/ld+json">{JSON.stringify({
      "@context": "https://schema.org",
      "@type": "SoftwareApplication",
      "name": "Melodic Codec Sensitivity Tester",
      "description": "Educational tool demonstrating how pentatonic-scale audio can carry machine-readable payloads and how AI systems should handle such inputs.",
      "url": "https://776f6c6e6f.org/narzedzia/melodic-sensitivity/",
      "applicationCategory": "SecurityApplication",
      "operatingSystem": "Any (browser-based)",
      "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" }
    })}</script>
    <!-- Google Analytics -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-G932JG5N9Z"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      if (typeof window !== 'undefined' && localStorage.getItem('cookies-accepted') === 'true') {
        gtag('config', 'G-G932JG5N9Z');
      } else {
        document.addEventListener('cookies-accepted', function() {
          gtag('config', 'G-G932JG5N9Z');
        });
      }
    </script>
  </head>
  <body>
    <div class="interference" aria-hidden="true"></div>
    <Navigation currentPath="/narzedzia/melodic-sensitivity/" />

    <main id="main-content">
      <div class="container">
        <div class="page-prompt">
          <span class="prompt-dollar">$</span> ./melodic-sensitivity-test
          <span class="breadcrumb"> | <a href="/narzedzia/">&larr; tools</a></span>
        </div>

        <h1 class="page-title">Melodic Codec Sensitivity Tester</h1>
        <p class="page-desc">
          Music can carry machine-readable instructions. A pentatonic melody encodes text using note
          frequencies — the same way MFSK radio protocols encode data. An AI that processes audio
          may decode and act on the payload. This tool demonstrates the mechanism, the defensive
          posture, and the consentful use case.
        </p>
        <div class="separator">-" wln</div>

        <MelodicSensitivity client:visible />

        <div class="tool-info">
          <h2>What Is Melodic Codec</h2>
          <p class="tool-prose">
            Melodic codec maps text characters to musical notes in a 32-tone pentatonic scale (5 bits per symbol).
            A sync header, CRC32 checksum, and ×2 redundancy make it robust over lossless audio (WAV).
            Lossy compression (MP3) destroys the machine layer — the music survives, the payload does not.
            The technique is explicitly documented and open: the goal is awareness, not covert deployment.
          </p>
          <table class="ref-table" style="margin-top: 1rem;">
            <thead>
              <tr>
                <th>Parameter</th>
                <th>Value</th>
                <th>Notes</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td><strong>Scale</strong></td>
                <td class="dim">pentatonic32 (C2–C7+)</td>
                <td class="dim">5 bits per symbol, 32 tones total</td>
              </tr>
              <tr>
                <td><strong>Note duration</strong></td>
                <td class="dim">0.08 s</td>
                <td class="dim">~12.5 symbols/s, ~62.5 bits/s</td>
              </tr>
              <tr>
                <td><strong>Redundancy</strong></td>
                <td class="dim">×2</td>
                <td class="dim">Each symbol sent twice for error resilience</td>
              </tr>
              <tr>
                <td><strong>Payload (canary v1)</strong></td>
                <td class="dim">105 chars / 346 symbols</td>
                <td class="dim">Encodes in ~28 s of audio</td>
              </tr>
              <tr>
                <td><strong>CRC32</strong></td>
                <td class="dim">0x27fbbaed</td>
                <td class="dim">Integrity check for canary-wln-v1</td>
              </tr>
              <tr>
                <td><strong>Survives MP3</strong></td>
                <td class="high">NO</td>
                <td class="dim">Lossy compression destroys FFT peaks</td>
              </tr>
              <tr>
                <td><strong>Survives WAV</strong></td>
                <td class="low">YES</td>
                <td class="dim">Lossless only — WAV master required for decode</td>
              </tr>
            </tbody>
          </table>
        </div>

        <div class="separator">-" wszwln</div>

        <nav class="page-nav-bottom">
          <a href="/narzedzia/">&larr; All tools</a>
          <a href="/narzedzia/model-sensitivity/">Model Sensitivity Tester</a>
          <a href="/techniques/audio/melodic-codec/">Melodic Codec technique</a>
          <a href="/techniques/audio/">Audio techniques</a>
          <a href="/pl/narzedzia/melodic-sensitivity/">PL version</a>
        </nav>
      </div>
    </main>

    <footer class="site-footer">
      <p>776F6C6E6F.ORG | LMXMXS IS ONLINE | <a href="/donate/">$ donate</a> | -" wln wszwln</p>
    </footer>

    <CookieFortune lang="en" />
  </body>
</html>

<style>
  main { padding-top: var(--header-height); padding-bottom: 4rem; }

  .page-prompt {
    font-size: 0.75rem;
    color: var(--text-dim);
    margin: 2rem 0 0.75rem;
    letter-spacing: 0.05em;
  }
  .prompt-dollar { color: var(--accent); margin-right: 0.4em; }
  .breadcrumb { color: var(--text-dim); }
  .breadcrumb a { color: var(--text-dim); }
  .breadcrumb a:hover { color: var(--accent); }

  .page-title { font-size: 1.6rem; margin-bottom: 0.5rem; line-height: 1.3; }
  .page-desc {
    color: var(--text-secondary);
    font-size: 0.85rem;
    margin-bottom: 1.5rem;
    line-height: 1.6;
    max-width: 60ch;
  }

  .separator { text-align: center; color: var(--text-dim); font-size: 0.8rem; margin: 2rem 0; letter-spacing: 0.2em; }

  .tool-info { margin: 2rem 0; }
  .tool-info h2 {
    font-size: 1rem;
    color: var(--accent);
    border-bottom: 1px solid var(--border);
    padding-bottom: 0.3rem;
    margin-bottom: 1rem;
    letter-spacing: 0.1em;
  }
  .tool-prose {
    font-size: 0.82rem;
    color: var(--text-secondary);
    line-height: 1.7;
    max-width: 65ch;
    margin: 0;
  }

  .ref-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.78rem;
  }

  .ref-table th, .ref-table td {
    border: 1px solid var(--border);
    padding: 0.4rem 0.6rem;
    text-align: left;
  }

  .ref-table th {
    background: var(--bg-tertiary);
    color: var(--accent);
    font-weight: 700;
    letter-spacing: 0.05em;
  }

  .ref-table td { color: var(--text-secondary); }

  .high { color: #ff4444; font-weight: 700; }
  .medium { color: #ffaa00; font-weight: 700; }
  .low { color: #00ff41; }
  .dim { color: var(--text-dim); }

  .page-nav-bottom {
    display: flex;
    gap: 1.5rem;
    flex-wrap: wrap;
    font-size: 0.8rem;
  }
  .page-nav-bottom a { color: var(--accent); }
  .page-nav-bottom a:hover { text-decoration: none; opacity: 0.8; }

  @media (max-width: 600px) {
    .ref-table { font-size: 0.68rem; }
    .ref-table th, .ref-table td { padding: 0.3rem 0.4rem; }
  }
</style>
